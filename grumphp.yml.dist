imports:
  - { resource: ./vendor/openeuropa/code-review-library/dist/library-conventions.yml }

grumphp:
  git_hook_variables:
    EXEC_GRUMPHP_COMMAND: 'docker-compose exec -T php'

parameters:
  tasks.phpstan.ignore_patterns:
    - src/Notification/Type
    - src/Request/Type
    - src/Authentication/ClientCertificate/Type
  tasks.phpcs.ignore_patterns:
    - src/Notification/Type
    - src/Request/Type
    - src/Authentication/ClientCertificate/Type
  tasks.phpcs.triggered_by:
    - php