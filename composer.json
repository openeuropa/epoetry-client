{
    "name": "openeuropa/epoetry-client",
    "type": "library",
    "description": "PHP client for the ePoetry service.",
    "license": "EUPL-1.2",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-soap": "*",
        "ext-xsl": "*",
        "cweagans/composer-patches": "^1 || ^2",
        "php-http/logger-plugin": "^1",
        "php-http/message": "~1.13",
        "php-soap/ext-soap-engine": "^1.7",
        "phpro/soap-client": "^4",
        "psr/http-client": "^1",
        "psr/http-client-implementation": "*",
        "psr/http-factory": "^1",
        "psr/http-factory-implementation": "*",
        "psr/log": "^3",
        "symfony/cache": "~7",
        "symfony/http-client": "~7",
        "symfony/serializer": "~7",
        "symfony/validator": "~7",
        "veewee/xml": "^3.0"
    },
    "require-dev": {
        "colinodell/psr-testlogger": "^1.1",
        "doctrine/annotations": "^1.13",
        "facile-it/php-openid-client": "^0.3.5",
        "monolog/monolog": "~3",
        "nyholm/psr7": "^1.4",
        "openeuropa/code-review-library": "^1.0@alpha",
        "openeuropa/task-runner": "^2",
        "php-http/guzzle7-adapter": "~1",
        "php-http/mock-client": "^1.5",
        "phpdocumentor/reflection-docblock": "^5",
        "phpunit/phpunit": "~9.6",
        "react/http": "^1.8",
        "symfony/config": "~7",
        "symfony/dependency-injection": "~7",
        "symfony/dotenv": "~7",
        "symfony/expression-language": "~7",
        "symfony/http-kernel": "~7",
        "symfony/monolog-bridge": "~7",
        "symfony/property-access": "~7",
        "symfony/property-info": "~7",
        "web-token/jwt-framework": "^4.0"
    },
    "suggest": {
        "symfony/console": "The Symfony Console component eases the creation of command line interfaces. Require this in your project if you wish to use the ePoetry Console.",
        "facile-it/php-openid-client": "Require this in your project if you use the OpenID Connect authentication plugin.",
        "web-token/jwt-framework": "Require this in your project if you use the OpenID Connect authentication plugin.",
        "symfony/http-client": "Require this in your project if you use the client certificate authentication plugin."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "php-http/discovery": true,
            "phpro/grumphp-shim": true
        }
    },
    "autoload": {
        "psr-4": {
            "OpenEuropa\\EPoetry\\": "./src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenEuropa\\EPoetry\\Tests\\": "./tests/"
        }
    },
    "bin": ["bin/epoetry"],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "patches": {
            "php-soap/encoding": {
                "Fix falsy attribute values (e.g. boolean false) being silently dropped during encoding": "patches/php-soap-encoding-fix-falsy-attribute-encoding.patch"
            }
        }
    }
}
